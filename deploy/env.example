# NeoApp2 runtime environment — copy to /etc/neoapp2/neoapp.env on the Azure VM.
# Never commit real secrets. chmod 640, chown root:neoapp.

# --- Web security (production defaults) ---
WEB_API_TOKEN=replace_with_openssl_rand_hex_32
TRADING_ENABLED=false
WEB_ALLOW_LOCAL_NOAUTH=false
WEB_LOG_LEVEL=INFO
WEB_POLL_SECONDS=5
WEB_MAX_BACKOFF_SECONDS=60
WORKER_HEALTH_WINDOW_SECONDS=30

# --- Kotak Neo API (required for worker login and symbol lookup) ---
CONSUMER_KEY=
MOBILE=
UCC=
MPIN=
TOTP_SECRET=

# --- Lot size / scrip masters (paths on VM shared storage) ---
NIFTY_LOT_SIZE=75
NSE_SCRIP_MASTER_PATH=/opt/neoapp2/shared/assets/nse_fo.csv
BSE_SCRIP_MASTER_PATH=/opt/neoapp2/shared/assets/bse_fo.csv

# --- Shared state (survives release symlink switches) ---
WEB_STATE_FILE=/opt/neoapp2/shared/logs/web_monitor_state.json
WEB_STATE_LOCK_FILE=/opt/neoapp2/shared/logs/web_monitor_state.lock
BUY_DISABLED_FILE=/opt/neoapp2/shared/data/buy_disabled.json

# --- Automation (keep false until TRADING_ENABLED is deliberately enabled) ---
AUTO_BUY_ENABLED=false
AUTO_SELL_ENABLED=false
AUTO_BASE_INDEX=NIFTY
AUTO_STRIKE_OFFSET=0
AUTO_LOTS=1
AUTO_TARGET=2
AUTO_SL=1.5
AUTO_TSL_STEP=1
AUTO_PT_STEP=1

# --- Optional: remote risk config / Telegram / capital tracking ---
# REMOTE_CONFIG_URL=
# PROGRESSIVE_LOSS_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CONFIGS=
# TELEGRAM_COOL_OFF=60
# COOL_OFF_PERIOD=0  # seconds between trades; 0 disables buy cool-off
# INITIAL_CAPITAL=
# CAPITAL_TOPUP=0
# PNL_RESET_DATE=
# MAX_DAILY_LOSS_COUNT=50

# Live trading: set TRADING_ENABLED=true ONLY after completing the validation
# checklist in deploy/AZURE_DEPLOY.md and explicit sign-off.
